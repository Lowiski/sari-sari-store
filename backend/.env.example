# Copy this file to .env and fill in your Neon connection string.
# Neon Dashboard -> Connection Details -> Connection string (pooled)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxxx.region.aws.neon.tech/neondb?sslmode=require

PORT=5000
NODE_ENV=development

# Use a long random string in production
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Comma separated origins allowed to call the API
CLIENT_URL=http://localhost:5173

# Demo credentials seeded by database/seed.sql
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
